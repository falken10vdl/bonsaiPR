# BonsaiPR Automation Configuration
# Copy this file to .env and update with your values

GITHUB_TOKEN=your_github_token_here

# Release target repository (where GitHub releases and index updates are published)
GITHUB_OWNER=falken10vdl
GITHUB_REPO=bonsaiPR

# Fork repository for merged build branches
FORK_OWNER=falken10vdl
FORK_REPO=IfcOpenShell

# Upstream source repository and base branch
SOURCE_REPO_OWNER=IfcOpenShell
SOURCE_REPO_NAME=IfcOpenShell
SOURCE_BASE_BRANCH=v0.8.0

BASE_CLONE_DIR=/home/falken10vdl/bonsaiPRDevel/IfcOpenShell
BUILD_BASE_DIR=/home/falken10vdl/bonsaiPRDevel/bonsaiPR-build
WORKING_DIR=/home/falken10vdl/bonsaiPRDevel/MergingPR
REPORT_PATH=/home/falken10vdl/bonsaiPRDevel
USERNAMES=""  # empty means all PR authors
EXCLUDED=""  # empty means no PRs are excluded

# Optional: skip PRs that change wheel-compiled C++ (BonsaiPR uses a pinned wheel)
# 0/empty = include all PRs, 1 = skip PRs that require C++ recompilation
SKIP_CPP_PRS=1

# Optional: full build timeout for check_and_build.py wrapper (default: 21600 = 6 hours)
BONSAIPR_FULL_BUILD_TIMEOUT_SECONDS=21600